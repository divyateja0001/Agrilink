AGRILINK_ENV=development
AGRILINK_DATABASE_TARGET=supabase
SUPABASE_DB_SCHEMA=agrilink
# Set only for a deliberate hackathon/demo environment. Never enable for a real marketplace.
DEMO_MODE=false
DEMO_PASSWORD=

# Copy both hosted URLs from Supabase Dashboard > Connect. Use the session pooler
# on port 5432. Passwords containing reserved URL characters must be percent-encoded.
SUPABASE_ADMIN_URL=postgresql+psycopg://postgres.PROJECT-REF:YOUR-OWNER-PASSWORD@YOUR-POOLER-HOST:5432/postgres
SUPABASE_DATABASE_URL=postgresql+psycopg://agrilink_app.PROJECT-REF:YOUR-APP-PASSWORD@YOUR-POOLER-HOST:5432/postgres
# Optional direct IPv6 URL for migrations. Leave blank to use the session pooler.
SUPABASE_MIGRATION_URL=
SUPABASE_APP_PASSWORD=replace-with-a-random-20-character-password

# Offline fallback. Used only with start-dev.ps1 -Database local.
LOCAL_DATABASE_URL=postgresql+psycopg://agrilink_app:CHANGE_ME@127.0.0.1:5432/agrilink
LOCAL_DB_SCHEMA=public

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
SECRET_KEY=replace-with-a-random-local-secret
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_HOURS=8
UPLOAD_MAX_MB=5
UPLOAD_FOLDER=
STATIC_FOLDER=
SERVE_FRONTEND=false
TRUST_PROXY=false
OUTBOX_POLL_SECONDS=3

# Optional role-aware assistant for buyers, farmers, and FPO managers. Keep this key only in backend\.env.
AI_ENABLED=false
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=20
MISTRAL_MAX_TOKENS=700

# Demo/development only. Keep false in production unless simulation is explicitly needed.
SIMULATED_TRACKING_ENABLED=true

# Optional browser push. Generate a VAPID pair and keep the private key server-side.
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@agrilink.local

# Razorpay Standard Checkout test mode only. Never commit keys or use rzp_live_ credentials here.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
